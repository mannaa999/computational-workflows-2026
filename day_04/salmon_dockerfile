FROM --platform=linux/amd64 debian:bookworm-slim

LABEL image.author.name="Kritika"
LABEL image.author.email="kritika.manna@student.uni-tuebingen.de"

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Download and install Salmon
RUN curl -L -o /tmp/salmon.tar.gz https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz && \
    tar -xzf /tmp/salmon.tar.gz -C /opt && \
    mv /opt/salmon-* /opt/salmon && \
    rm /tmp/salmon.tar.gz

# Set the PATH environment variable so salmon can be run by name
ENV PATH="$PATH:/opt/salmon/bin"